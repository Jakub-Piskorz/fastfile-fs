<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteBase /fastfile/

  # Serve static files directly if they exist (fonts, images, css, js, etc.)
  RewriteCond %{REQUEST_URI} \.(woff2?|ttf|otf|eot|svg|jpg|jpeg|png|gif|css|js|ico)$ [NC]
  RewriteRule ^ - [L]

  # If requested file or directory exists, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # All other requests rewrite to index.html (React Router handles routing)
  RewriteRule . /fastfile/index.html [L]
</IfModule>