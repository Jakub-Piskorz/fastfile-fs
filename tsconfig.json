{
  "compilerOptions": {
    "target": "es5",
    "module": "es6",
    "lib": [
      "es2016",
      "dom"
    ],
    "allowJs": true,
    "jsx": "react-jsx",
    "outDir": "./dist/",
    "importHelpers": true,
    "strict": true,
    "noImplicitAny": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
    },
    "typeRoots": [
      "src/types"
    ],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": false,
    "forceConsistentCasingInFileNames": true,
  },
  "include": [
    "src"
  ]
}